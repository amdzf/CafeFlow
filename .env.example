APP_NAME="CafeFlow POS"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_TIMEZONE="Asia/Jakarta"

# Database Configuration (XAMPP Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cafeflow_pos
DB_USERNAME=root
DB_PASSWORD=

# Midtrans Payment Gateway (QRIS)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY="your-midtrans-server-key-here"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key-here"
MIDTRANS_MERCHANT_ID="your-merchant-id-here"

# Cafe Default Settings
CAFE_TAX_PERCENT=10
CAFE_SERVICE_PERCENT=0
CAFE_CURRENCY="Rp"
